dbg:tracer(process, {fun
    (Msg, State) ->
        Fields = [call_id, call_id_helper, origination_call_id, context,
                  control_q, control_q_helper, controller_q,
                  caller_id_name, caller_id_number, callee_id_name,
                  callee_id_number, switch_nodename, switch_hostname,
                  switch_url, switch_uri, request, request_user,
                  request_realm, from, from_user, from_realm,
                  to, to_user, to_realm, inception, account_db,
                  account_id, authorizing_id, authorizing_type,
                  owner_id, fetch_id, bridge_id, language,
                  app_name, app_version, custom_publish_fun,
                  ccvs, cavs, sip_headers, kvs, other_leg_call_id,
                  resource_type, to_tag, from_tag, direction,
                  call_bridged, message_left, is_recording,
                  is_call_forward],

        PrintCall = fun(Tuple) ->
            [kapps_call | Values] = tuple_to_list(Tuple),
            Pairs = lists:zip(Fields, Values),
            lists:foreach(fun({Key, Val}) ->
                io:format("    ~-22s: ~62p~n", [Key, Val])
            end, Pairs)
        end,

        PrintArg = fun PA(Arg, Indent) when is_tuple(Arg), element(1, Arg) =:= kapps_call ->
                       io:format("~s[kapps_call record]~n", [Indent]),
                       PrintCall(Arg);
                   PA(Arg, Indent) when is_tuple(Arg), tuple_size(Arg) > 1 ->
                       io:format("~s{tuple of ~p elements}~n", [Indent, tuple_size(Arg)]),
                       lists:foreach(fun(Elem) -> PA(Elem, [$\s,$\s | Indent]) end,
                                     tuple_to_list(Arg));
                   PA(Arg, Indent) when is_list(Arg), Arg =/= [] ->
                       case io_lib:printable_list(Arg) of
                           true ->
                               io:format("~s~62p~n", [Indent, Arg]);
                           false ->
                               io:format("~s[list of ~p elements]~n", [Indent, length(Arg)]),
                               lists:foreach(fun(Elem) -> PA(Elem, [$\s,$\s | Indent]) end, Arg)
                       end;
                   PA(Arg, Indent) ->
                       io:format("~s~62p~n", [Indent, Arg])
                   end,

        case Msg of
            {trace, Pid, call, {Mod, Fun, Args}} ->
                io:format("~n=== CALL ~p:~p/~p by ~p ===~n", [Mod, Fun, length(Args), Pid]),
                lists:foldl(fun(Arg, N) ->
                    io:format("arg~p:~n", [N]),
                    PrintArg(Arg, "  "),
                    N + 1
                end, 1, Args);
            {trace, Pid, return_from, {Mod, Fun, Arity}, RetVal} ->
                io:format("~n=== RETURN ~p:~p/~p by ~p ===~n", [Mod, Fun, Arity, Pid]),
                PrintArg(RetVal, "  ");
            _ ->
                io:format("~p~n", [Msg])
        end,
        State
end, ok}).

